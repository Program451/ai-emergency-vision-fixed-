# Скопируй в .env и заполни своими значениями.
# Groq — опционально. Без ключа система работает на rule-based текстах (без LLM).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Telegram — три отдельных бота, по одному на службу.
# Без токена/chat_id для конкретной службы — просто лог в консоль, pipeline не падает.
TELEGRAM_BOT_TOKEN_POLICE=
TELEGRAM_CHAT_ID_POLICE=

TELEGRAM_BOT_TOKEN_MEDICAL=
TELEGRAM_CHAT_ID_MEDICAL=

TELEGRAM_BOT_TOKEN_FIRE=
TELEGRAM_CHAT_ID_FIRE=
